{
  "name": "ai-client-sdk",
  "version": "4.3.2",
  "type": "module",
  "description": "用于开发 AI 应用，适配任意前端框架，兼容多种大模型，提供对话界面、Function Calling、Agent、工作流等",
  "author": {
    "name": "Hughe5",
    "email": "2100921003@qq.com",
    "url": "https://github.com/Hughe5"
  },
  "contributors": [
    {
      "name": "shichzh",
      "email": "1767604480@qq.com",
      "url": "https://github.com/shichzh"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shichzh/ai-client-sdk.git"
  },
  "types": "dist/index.d.ts",
  "main": "./dist/ai-client-sdk.umd.cjs",
  "module": "./dist/ai-client-sdk.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ai-client-sdk.js",
      "require": "./dist/ai-client-sdk.umd.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && rollup -c rollup.config.ts",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "type:check": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "license:check": "addlicense -check -c \"Copyright\" -l apache \"examples\" \"src\"",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "artificial-intelligence",
    "ai-sdk",
    "ai-integration",
    "function-calling",
    "chatbot",
    "multi-model",
    "frontend",
    "frontend-sdk",
    "web-sdk",
    "llm",
    "large-language-model",
    "openai-compatible",
    "ai-client",
    "chat",
    "ai-chat",
    "ai-tools",
    "pure-javascript"
  ],
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "ajv": "^8.20.0",
    "antd": "^6.4.1",
    "chrono-node": "^2.9.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.3",
    "lodash-es": "^4.18.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
