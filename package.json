{
  "name": "ai-client-sdk",
  "version": "3.0.7",
  "description": "开发 AI 应用的 SDK，适配任意前端框架，兼容多种大模型、对话界面、Function Calling、Agent、工作流等。",
  "author": {
    "name": "Hughe5",
    "email": "2100921003@qq.com",
    "url": "https://github.com/Hughe5"
  },
  "contributors": [
    {
      "name": "shichzh",
      "email": "1767604480@qq.com",
      "url": "https://github.com/shichzh"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shichzh/ai-client-sdk.git"
  },
  "types": "dist/index.d.ts",
  "main": "./dist/ai-client-sdk.umd.js",
  "module": "./dist/ai-client-sdk.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ai-client-sdk.mjs",
      "require": "./dist/ai-client-sdk.umd.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-license": "addlicense -check -c \"Hughe5\" -l apache \"examples\" \"src\""
  },
  "keywords": [
    "ai",
    "artificial-intelligence",
    "ai-sdk",
    "ai-integration",
    "function-calling",
    "chatbot",
    "multi-model",
    "frontend",
    "frontend-sdk",
    "web-sdk",
    "llm",
    "large-language-model",
    "openai-compatible",
    "ai-client",
    "chat",
    "ai-chat",
    "ai-tools",
    "pure-javascript"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "chrono-node": "^2.8.3",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.7",
    "lodash-es": "^4.17.21",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "prettier": "^3.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
