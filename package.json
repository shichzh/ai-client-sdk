{
  "name": "ai-client-sdk",
  "version": "6.0.0",
  "type": "module",
  "description": "用于开发 AI 应用，适配任意前端框架，支持所有 OpenAI-compatible 大模型，提供对话界面、Agent、MCP、工作流等",
  "author": {
    "name": "Hughe5",
    "email": "2100921003@qq.com",
    "url": "https://github.com/Hughe5"
  },
  "contributors": [
    {
      "name": "shichzh",
      "email": "1767604480@qq.com",
      "url": "https://github.com/shichzh"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shichzh/ai-client-sdk.git"
  },
  "types": "dist/index.d.ts",
  "main": "./dist/ai-client-sdk.umd.cjs",
  "module": "./dist/ai-client-sdk.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ai-client-sdk.js",
      "require": "./dist/ai-client-sdk.umd.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && rollup -c rollup.config.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type:check": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "license:check": "addlicense -check -c \"Copyright\" -l apache \"examples\" \"src\"",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "artificial-intelligence",
    "ai-sdk",
    "ai-integration",
    "function-calling",
    "chatbot",
    "multi-model",
    "frontend",
    "frontend-sdk",
    "web-sdk",
    "llm",
    "large-language-model",
    "openai-compatible",
    "ai-client",
    "chat",
    "ai-chat",
    "ai-tools",
    "pure-javascript"
  ],
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "antd": "^6.6.0",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.13",
    "lodash-es": "^4.18.1",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
